{
  "name": "ai-statement-analyzer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "api": "tsx src/server.ts",
    "migrate": "tsx src/migrate.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "dotenv": "17.4.2",
    "hono": "4.13.5",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/pg": "^8.23.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
