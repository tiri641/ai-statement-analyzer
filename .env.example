NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://app:local_dev_password@localhost:5432/statement_analyzer
POSTGRES_DB=statement_analyzer
POSTGRES_USER=app
POSTGRES_PASSWORD=local_dev_password
POSTGRES_PORT=5432
AWS_REGION=ap-northeast-1
DB_SSL=false
BEDROCK_OCR_MODEL_ID=jp.amazon.nova-2-lite-v1:0
BEDROCK_INSIGHTS_MODEL_ID=
# Inference Profileを使う場合だけ、紐づくFoundation Model ARNをカンマ区切りで指定する
BEDROCK_OCR_FOUNDATION_MODEL_ARNS=
BEDROCK_INSIGHTS_FOUNDATION_MODEL_ARNS=
INSIGHTS_PROMPT_VERSION=v1
S3_BUCKET_NAME=
SQS_QUEUE_URL=
S3_PRESIGNED_URL_EXPIRES_SECONDS=300
S3_RAW_RETENTION_DAYS=7
FRONTEND_ORIGIN=http://localhost:5173
